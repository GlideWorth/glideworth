---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { mdxComponents } from '../../components/mdx';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('features')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'features'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.noindex}
  eyebrow="Feature"
  lede={entry.data.description}
  headings={headings}
  crumbs={[
    { label: 'Features', href: '/features/' },
    { label: entry.data.title, href: `/features/${entry.id}/` },
  ]}
>
  <Content components={mdxComponents} />
</EntryLayout>
