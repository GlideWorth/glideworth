---
/**
 * How a spending solver finds an answer: it runs the plan at different spending levels and looks for
 * the highest one whose chance of success still meets the target. The curve and numbers are
 * ILLUSTRATIVE (a made-up plan); the shape (success falls as spending rises) is real.
 */
const points: [number, number][] = [
  [30_000, 0.99],
  [34_000, 0.97],
  [38_000, 0.93],
  [42_000, 0.86],
  [46_000, 0.76],
  [50_000, 0.62],
];
const x = (n: number) => 56 + ((n - 28_000) / (52_000 - 28_000)) * 500;
const y = (p: number) => 20 + (1 - (p - 0.5) / 0.5) * 150;
const path = points.map(([n, p], i) => `${i ? 'L' : 'M'}${x(n).toFixed(1)} ${y(p).toFixed(1)}`).join(' ');
const answerX = x(39_800);
---

<figure class="ss">
  <svg viewBox="0 0 600 220" role="img" aria-label="Illustrative chart: chance of success falls from 99 percent to 62 percent as yearly spending rises from 30,000 to 50,000. The 90 percent target line meets the curve near 39,800.">
    <line x1="56" x2="556" y1={y(0.9)} y2={y(0.9)} class="target" />
    <text x="552" y={y(0.9) - 6} text-anchor="end" class="s">target: 90%</text>
    <path d={path} class="curve" />
    {points.map(([n, p]) => <circle cx={x(n)} cy={y(p)} r="3.5" class="pt" />)}
    <line x1={answerX} x2={answerX} y1={y(0.9)} y2="176" class="ans" />
    <circle cx={answerX} cy={y(0.9)} r="6" class="hit" />
    <text x={answerX} y="196" text-anchor="middle" class="l">answer: about 39,800 a year</text>
    {[30_000, 40_000, 50_000].map((n) => <text x={x(n)} y="212" text-anchor="middle" class="s">{n.toLocaleString('en-GB')}</text>)}
    {[1, 0.75, 0.5].map((p) => <text x="48" y={y(p) + 4} text-anchor="end" class="s">{Math.round(p * 100)}%</text>)}
  </svg>
  <figcaption>Illustrative. Each dot is a full Monte Carlo run at one spending level; the solver narrows in on the target.</figcaption>
</figure>

<style>
  .ss {
    padding: clamp(0.75rem, 0.6rem + 1vw, 1.25rem);
    background: var(--surface);
    display: grid;
    gap: 0.4rem;
  }
  svg {
    width: 100%;
    height: auto;
  }
  .curve {
    fill: none;
    stroke: var(--accent-text);
    stroke-width: 2;
  }
  .pt {
    fill: var(--surface);
    stroke: var(--accent-text);
    stroke-width: 1.5;
  }
  .target {
    stroke: var(--ochre);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  .ans {
    stroke: var(--ink-3);
    stroke-dasharray: 2 3;
  }
  .hit {
    fill: var(--ochre-soft);
    stroke: var(--ochre);
    stroke-width: 2;
  }
  .l {
    font: 600 11px var(--font-sans);
    fill: var(--ink);
  }
  .s {
    font: 10px var(--font-sans);
    fill: var(--ink-3);
  }
  figcaption {
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--ink-3);
  }
</style>
