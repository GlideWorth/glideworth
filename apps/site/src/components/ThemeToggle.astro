---
/**
 * Light / dark switch. The page follows the system theme until the visitor chooses; the choice is kept
 * in localStorage ("theme") and applied before first paint by the inline script in BaseLayout.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch colour theme" hidden>
  <svg class="icon-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M10 1.8v2.1M10 16.1v2.1M1.8 10h2.1M16.1 10h2.1M4.2 4.2l1.5 1.5M14.3 14.3l1.5 1.5M4.2 15.8l1.5-1.5M14.3 5.7l1.5-1.5"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <path
      d="M16.5 12.4A7 7 0 0 1 7.6 3.5a7 7 0 1 0 8.9 8.9Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const current = (): 'light' | 'dark' =>
    root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : media.matches ? 'dark' : 'light';

  function sync(button: HTMLButtonElement) {
    const theme = current();
    button.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    button.dataset.current = theme;
    // An explicit choice overrides both media-specific theme-color values (the browser chrome colour).
    if (root.dataset.theme) {
      for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
        meta.content = theme === 'dark' ? '#0f1311' : '#f5f2ea';
      }
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.hidden = false;
    sync(button);
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be blocked; the choice then lasts for this page only.
      }
      sync(button);
    });
    media.addEventListener('change', () => sync(button));
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-2);
  }
  @media (pointer: coarse) {
    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--line);
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .icon-moon {
    display: none;
  }
  .theme-toggle[data-current='dark'] .icon-sun {
    display: none;
  }
  .theme-toggle[data-current='dark'] .icon-moon {
    display: block;
  }
</style>
