---
import { getCollection } from 'astro:content';
import Callout from '../../components/Callout.astro';
import Card from '../../components/Card.astro';
import CTABand from '../../components/CTABand.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import Section from '../../components/Section.astro';
import { page } from '../../config/pages';
import PageLayout from '../../layouts/PageLayout.astro';
import { facts } from '../../lib/facts';

const entries = (await getCollection('features')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  {...page('/features/')}
  heading="Everything the planner does"
  eyebrow="Features"
  lede="Glideworth tells you how much you can spend and when you can retire, shows year by year why a plan works or falls short, and lets you compare what-ifs side by side. Each guide below says what a feature does and what it does not."
  crumbs={[{ label: 'Features', href: '/features/' }]}
>
  <Section title="Feature guides" intro="One page per capability, with a worked illustration and an honest list of limits." tight>
    <div class="cards">
      {
        entries.map((e) => (
          <Card title={e.data.title} href={`/features/${e.id}/`}>
            <p>{e.data.summary}</p>
          </Card>
        ))
      }
    </div>
  </Section>
  <Section title="At a glance" tight>
    <FeatureGrid
      items={[
        { glyph: 'solver', title: 'What you can spend, when you can retire', href: '/features/solvers/', body: 'The most you can spend, the earliest date you can retire, the savings you need and a safe withdrawal rate, at the chance of success you choose.' },
        { glyph: 'ledger', title: 'Every year, line by line', href: '/features/projections-and-ledger/', body: "A table for each year of income, tax, spending and withdrawals, in today's money or future money, for one person or a couple." },
        { glyph: 'ledger', title: 'Why a plan falls short', href: '/features/explanations-and-audit/', body: 'Plain answers to why the plan fails, where the money went in a year and what changed between two plans, plus a check of your assumptions.' },
        { glyph: 'branch', title: 'Scenarios side by side', href: '/features/branches-and-change-sets/', body: 'What-if copies of your plan that follow the original, compared side by side, with version history and undo.' },
        { glyph: 'fan', title: 'Tested against market history', href: '/features/monte-carlo/', body: 'Thousands of simulated markets, from history or from random returns, showing how often the plan lasts and when it fails.' },
        { glyph: 'fan', title: 'Spending guardrails', href: '/features/withdrawal-strategies/', body: 'Withdrawal rules from a fixed amount to Guyton-Klinger, and guardrails that show what to spend this year and when you would cut.' },
        { glyph: 'people', title: 'Plan as a couple', href: '/features/sharing-and-roles/', body: 'Each partner signs in to the same household, with survivor scenarios for what happens if one of you dies.' },
        { glyph: 'globe', title: `Tax for ${facts.taxCountryCount} countries`, href: '/features/tax-estimates/', body: 'Estimates for your country, for stated tax years, each with a written list of what it leaves out. Flat or custom rates elsewhere.' },
        { glyph: 'plug', title: 'ChatGPT or Claude on your plan', href: '/features/mcp-server/', body: 'Connect your assistant and ask about your plan in your own words. Any change it suggests is a proposal you approve.' },
        { glyph: 'import', title: 'Import and export', href: '/features/import-and-export/', body: 'No bank login: type in balances, or import a ProjectionLab export or bank and budgeting CSVs. Everything exports.' },
        { glyph: 'ledger', title: 'Progress and check-ins', href: '/features/progress-and-check-ins/', body: 'Record balances against the plan, and get told when your chance of success or a milestone moves.' },
        { glyph: 'code', title: 'For developers', href: '/api/', body: `A REST API with ${facts.apiOperations} operations and an MCP server with ${facts.mcpTools} tools, with scoped keys and signed webhooks.` },
      ]}
      columns={4}
    />
  </Section>
  <Section title="What the planner does not do" width="narrow" tight>
    <Callout type="note" title="Read this before relying on a number">
      <p>
        Glideworth is planning software, not advice, and every tax figure is an estimate for a stated tax year. It
        steps by year, not by month; it does not connect to bank accounts; and it does not randomise lifespan or care
        costs in simulations. Each feature
        guide lists its own limits, and the full status of the project is in the
        <a href="/roadmap/">roadmap</a>.
      </p>
    </Callout>
    <p class="more">
      Features that belong to the hosted service rather than the planner, such as accounts, billing, two-factor
      sign-in, automatic backups and email check-ins, are in the hosted service only. See <a href="/pricing/">pricing</a>
      and <a href="/security/">security</a> for which is which. The self-hosted build has every planner feature:
      <a href="/self-hosting/">self-hosting</a>.
    </p>
  </Section>
  <CTABand />
</PageLayout>

<style>
  .cards {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .more {
    margin-top: var(--space-m);
    color: var(--ink-2);
  }
</style>
