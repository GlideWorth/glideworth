---
/**
 * Documentation page: sidebar of every doc grouped by section (src/lib/docs.ts), the body, and an
 * "On this page" column on wide screens. On small screens the sidebar folds into a disclosure.
 */
import type { MarkdownHeading } from 'astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Prose from '../components/Prose.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { docHref, docsSidebar } from '../lib/docs';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  section?: string;
  headings?: MarkdownHeading[];
  lastChecked?: Date | undefined;
}
const { title, description, path, noindex = false, section, headings = [], lastChecked } = Astro.props;
const sidebar = await docsSidebar();
const crumbs = [
  { label: 'Docs', href: '/docs/' },
  ...(path === '/docs/' ? [] : [{ label: title, href: path }]),
];
---

<BaseLayout title={title} description={description} path={path} noindex={noindex}>
  <div class="container docs">
    <nav class="docs-nav" aria-label="Documentation">
      <details class="docs-nav-toggle" open>
        <summary>Documentation menu</summary>
        <ul role="list" class="docs-sections">
          {
            sidebar.map((s) => (
              <li>
                <details class="docs-group" open data-current={s.entries.some((e) => docHref(e.id) === path) || undefined}>
                  <summary class="docs-section">{s.name}</summary>
                  <ul role="list">
                    {s.entries.map((e) => (
                      <li>
                        <a href={docHref(e.id)} aria-current={docHref(e.id) === path ? 'page' : undefined}>
                          {e.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
    <!-- On small screens the menu starts closed, and when opened shows only the current group expanded; on
         wide screens everything stays open. Without JavaScript everything is open. Inline and directly
         after the menu so that it runs before the first paint: as a deferred script it sometimes ran
         after it, and the whole article then jumped up by the height of the menu. The deploy hashes
         inline scripts for the Content-Security-Policy (infra/scripts/gen-csp.sh). -->
    <script is:inline>
      (function () {
        if (!window.matchMedia('(max-width: 63.99rem)').matches) return;
        var menu = document.querySelector('.docs-nav-toggle');
        if (menu) menu.open = false;
        var groups = document.querySelectorAll('.docs-group');
        for (var i = 0; i < groups.length; i++) groups[i].open = groups[i].hasAttribute('data-current');
      })();
    </script>

    <article class="docs-main">
      <Breadcrumbs items={crumbs} />
      <header class="docs-head">
        {section && <span class="eyebrow">{section}</span>}
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </header>
      <Prose wide><slot /></Prose>
      <RelatedLinks />
      {
        lastChecked && (
          <p class="checked">
            Last checked against the code on{' '}
            <time datetime={lastChecked.toISOString().slice(0, 10)}>
              {lastChecked.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}
            </time>
            .
          </p>
        )
      }
    </article>

    <aside class="docs-toc" aria-label="On this page"><TableOfContents headings={headings} /></aside>
  </div>
</BaseLayout>


<style>
  .docs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-xl) var(--section-y);
  }
  @media (min-width: 64rem) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }
  @media (min-width: 80rem) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr) 13rem;
    }
  }
  .docs-nav {
    font-size: var(--text-sm);
  }
  @media (min-width: 64rem) {
    .docs-nav {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      align-self: start;
      max-height: calc(100vh - var(--header-h) - 3rem);
      overflow-y: auto;
    }
    .docs-nav-toggle > summary {
      display: none;
    }
  }
  .docs-nav-toggle > summary {
    cursor: pointer;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    font-weight: 600;
    background: var(--surface);
  }
  .docs-sections {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-s);
  }
  .docs-section {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.4rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    padding: 0.2rem 0.6rem 0.2rem 0;
  }
  .docs-section::-webkit-details-marker {
    display: none;
  }
  .docs-section::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 150ms var(--ease);
  }
  .docs-group[open] > .docs-section::after {
    transform: rotate(45deg);
  }
  .docs-group:has([aria-current='page']) > .docs-section {
    color: var(--accent-text);
  }
  .docs-sections ul {
    display: grid;
    gap: 0.1rem;
  }
  .docs-sections a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-s);
    color: var(--ink-2);
    text-decoration: none;
  }
  .docs-sections a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .docs-sections a[aria-current='page'] {
    color: var(--accent-text);
    background: var(--accent-soft);
    font-weight: 600;
  }
  .docs-main {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    align-content: start;
  }
  .docs-head {
    display: grid;
    gap: var(--space-xs);
  }
  .docs-head h1 {
    font-size: var(--text-3xl);
  }
  .docs-toc {
    display: none;
  }
  @media (min-width: 80rem) {
    .docs-toc {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      align-self: start;
    }
  }
  .checked {
    color: var(--ink-3);
    font-size: var(--text-xs);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }
</style>
