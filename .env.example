# Copy to .env. Every variable Glideworth reads is listed here with its default.
# `pnpm dev` and `pnpm start` load ../../.env (apps/api); Docker Compose reads it for substitution.
# Upgrading from Cairn: the old CAIRN_* names keep working as aliases (GLIDEWORTH_* wins when both are set;
# the server warns once at start-up). See docs/SELF-HOSTING.md, "Upgrading from Cairn".

# =============================================================================================
# API (apps/api)
# =============================================================================================
# Port the API (and, in production, the web app) listens on.
GLIDEWORTH_API_PORT=8787
# Interface to bind. Empty = all interfaces. Use 127.0.0.1 behind a reverse proxy on the same host.
GLIDEWORTH_HOST=
# SQLite file. Relative paths resolve from apps/api. (Docker: fixed to /data/glideworth.db on the volume.)
# If this file does not exist yet but cairn.db (the name before the rename) does in the same directory, that
# file is used instead; it is never moved or copied.
GLIDEWORTH_DB_PATH=./data/glideworth.db
# Bootstrap API key. On boot, if no keys exist, this key is inserted with read+write scope.
# Format: glideworth_<8 lowercase alnum>_<32+ chars> (cairn_... keys from before the rename still work).
# Generate one with `pnpm keys:create` instead for real use.
# This example value is public: with NODE_ENV=production (pnpm start, Docker) the server REFUSES to insert it.
GLIDEWORTH_BOOTSTRAP_KEY=glideworth_devlocal_0123456789abcdef0123456789abcdef
# Seed a synthetic sample household + plans into an EMPTY database (true/false). Keep false in production.
GLIDEWORTH_SEED_SAMPLE=true
# Allowed CORS origin for the web app when it is served from another origin (the Vite dev server).
# Leave it EMPTY in production: the web app is then same-origin and no other origin is trusted.
GLIDEWORTH_WEB_ORIGIN=http://localhost:5173
# Let MCP clients propose and apply change sets (true/false). Off = MCP is read-only. Needs a write-scope key too.
GLIDEWORTH_MCP_ALLOW_WRITES=false
# Background jobs (Monte Carlo, solvers...) running at the same time, 1-16.
GLIDEWORTH_MAX_JOBS=2
# Worker threads ONE Monte Carlo run is split across. Empty = min(CPU count, 4); 1 = no sharding.
GLIDEWORTH_MC_SHARDS=
# Requests per minute per API key / session; 0 = unlimited.
GLIDEWORTH_RATE_LIMIT_PER_MIN=600
# Largest request body, in megabytes (413 beyond it).
GLIDEWORTH_MAX_BODY_MB=10
# Allow webhook URLs that point at loopback / private / link-local addresses (true/false). Off = SSRF guard.
GLIDEWORTH_WEBHOOK_ALLOW_PRIVATE=false

# =============================================================================================
# Production: one process, one port (`pnpm build && pnpm start`, or Docker)
# =============================================================================================
# NODE_ENV=production is set by `pnpm start` and the Docker image. In production the API also serves
# the built web app (apps/web/dist) with SPA fallback on the same port.
# Force serving the web app on or off (default: on in production, off in dev).
GLIDEWORTH_SERVE_WEB=
# Directory of the built web app. Default: apps/web/dist next to apps/api. (Docker: /app/web.)
GLIDEWORTH_WEB_DIST=

# ---- Browser sign-in (passphrase + session cookie). API keys always keep working. ----
# Set GLIDEWORTH_BROWSER_AUTH=false to accept API keys only.
GLIDEWORTH_BROWSER_AUTH=true
# If set, first-run setup must send this token too, so nobody else can claim a fresh, reachable instance.
# At least 8 characters. Remove it once you have set your passphrase if you like.
GLIDEWORTH_SETUP_TOKEN=
# Session lifetime and idle timeout, in hours.
GLIDEWORTH_SESSION_TTL_HOURS=168
GLIDEWORTH_SESSION_IDLE_HOURS=24
# Cookie "Secure" flag: auto (when the request is https / X-Forwarded-Proto: https), true or false.
GLIDEWORTH_COOKIE_SECURE=auto
# Trust X-Forwarded-For for login throttling. Only behind a reverse proxy you control.
GLIDEWORTH_TRUST_PROXY=false
# Failed logins allowed per client within the window, and the window length in minutes.
GLIDEWORTH_LOGIN_MAX_ATTEMPTS=5
GLIDEWORTH_LOGIN_WINDOW_MINUTES=15

# =============================================================================================
# Docker Compose (docker-compose.yml)
# =============================================================================================
# Host port the container is published on.
GLIDEWORTH_PORT=8787

# =============================================================================================
# Web dev server (apps/web, `pnpm dev`)
# =============================================================================================
# The Vite dev server proxies /api and injects this key server-side, so the key is never shipped in
# the browser bundle. (A deployed instance uses the passphrase login instead.)
GLIDEWORTH_API_URL=http://localhost:8787
GLIDEWORTH_API_KEY=glideworth_devlocal_0123456789abcdef0123456789abcdef

# =============================================================================================
# Self-host job limits
# =============================================================================================
# Longest a background job (Monte Carlo, solver, sensitivity, attribution) may run, in seconds. Beyond it the
# job is stopped and fails with JOB_TIMEOUT. Empty = the built-in default (1800).
GLIDEWORTH_MAX_JOB_SECONDS=
# Heap limit of one job thread, in MiB. A job that needs more fails with JOB_OUT_OF_MEMORY. Empty = the
# built-in default (2048).
GLIDEWORTH_WORKER_MAX_MB=
# Imports (bank files, CSV, Glideworth / ProjectionLab documents) are parsed in import threads, shared by every
# workspace in the process. Empty = the built-in defaults: min(2, CPUs - 1) threads, 8 imports waiting (more are
# 503 IMPORT_BUSY), 15 s per import (then 422 IMPORT_TIMEOUT) and 512 MiB heap per thread (422 IMPORT_OUT_OF_MEMORY).
GLIDEWORTH_IMPORT_WORKERS=
GLIDEWORTH_IMPORT_QUEUE=
GLIDEWORTH_IMPORT_TIMEOUT_SECONDS=
GLIDEWORTH_IMPORT_WORKER_MAX_MB=

# =============================================================================================
# CLOUD MODE (hosted Glideworth). Ignored by self-hosting. Read only when GLIDEWORTH_MODE=cloud.
# See docs/design/cloud-architecture.md, packages/cloud/INTEGRATION.md and docs/ops/.
# Cloud mode REFUSES TO START (naming the variable, never its value) if any of these single-tenant settings is
# set, with the GLIDEWORTH_ or the old CAIRN_ prefix: GLIDEWORTH_BOOTSTRAP_KEY, GLIDEWORTH_SETUP_TOKEN,
# GLIDEWORTH_DB_PATH, or GLIDEWORTH_WEBHOOK_ALLOW_PRIVATE=true. Leave all four unset.
# In production (NODE_ENV=production) it also refuses GLIDEWORTH_EMAIL_TRANSPORT=file, GLIDEWORTH_BILLING=fake
# and a missing GLIDEWORTH_TURNSTILE_SECRET or GLIDEWORTH_S3_BUCKET.
# Every assignment below is commented out so a copy of this file stays a self-host configuration: uncomment
# them (and remove the single-tenant ones above) for a cloud deployment.
# Secrets below are placeholders: generate real ones (`openssl rand -hex 32`) and keep them out of git.
# =============================================================================================
# Deployment mode: selfhost (default) or cloud.
# GLIDEWORTH_MODE=cloud
# Module that gives the `glideworth-cloud` CLI and the server the tenant runtime. The cloud image sets it.
# GLIDEWORTH_TENANT_RUNTIME_MODULE=
# Public https origin of the service (no credentials, query or fragment). Required. Used in links and emails.
# GLIDEWORTH_PUBLIC_URL=https://app.example.com
# Directory holding the control-plane database and every workspace database. Default /data.
# GLIDEWORTH_DATA_DIR=/data
# Pricing file (plans, prices, interval, currency, tax behaviour). Required. See packages/billing/pricing.example.json.
# GLIDEWORTH_PRICING_FILE=/etc/glideworth/pricing.json
# 32-byte key (64 hex characters or base64) that encrypts stored secrets. Required. Must differ from the backup key.
# GLIDEWORTH_SECRETS_KEY=
# 32-byte key (64 hex characters or base64) that wraps backups. Required. Must differ from GLIDEWORTH_SECRETS_KEY.
# GLIDEWORTH_BACKUP_KEK=
# Identifier of the backup key, 1-32 characters of A-Z a-z 0-9 . _ -. Change it when you rotate the key. Default k1.
# GLIDEWORTH_BACKUP_KEK_ID=k1
# Background jobs running at the same time across all workspaces, 1-1024. Default: CPU count minus one.
# (Also in the API section above for self-host: set it once.)
# GLIDEWORTH_MAX_JOBS=2
# Workspaces kept open in memory at once, 1-100000. Default 256.
# GLIDEWORTH_TENANT_CACHE_SIZE=256
# Host:port of the private operations listener (health, metrics). Default 127.0.0.1:8789.
# GLIDEWORTH_OPS_LISTEN=127.0.0.1:8789
# The public listener uses GLIDEWORTH_API_PORT and GLIDEWORTH_HOST from the API section above.
# Trust X-Forwarded-For from the reverse proxy in front (true/false). Only behind a proxy you control.
# (Also in the browser sign-in section above for self-host: set it once.)
# GLIDEWORTH_TRUST_PROXY=true
# Log level: debug, info, warn or error. Default info.
# GLIDEWORTH_LOG_LEVEL=info
# Serve the built web app (true/false), and where it is. The cloud image sets both.
# GLIDEWORTH_SERVE_WEB=
# GLIDEWORTH_WEB_DIST=

# ---- Email (outgoing application email) ----
# Transport: file (development: writes to <data dir>/mail-outbox), resend (Resend's HTTP API: the hosted
# service), smtp (any SMTP relay) or mailgun (adapter kept). The file transport is refused in production.
# GLIDEWORTH_EMAIL_TRANSPORT=resend
# Resend API key for the resend transport (a key with sending access to your domain only).
# GLIDEWORTH_RESEND_API_KEY=
# SMTP URL for the smtp transport, for example smtps://user:password@smtp.example.com:465
# GLIDEWORTH_SMTP_URL=
# Sender of application email, "Name <address>" or an address. Use an address on the sending subdomain.
# GLIDEWORTH_EMAIL_FROM=Glideworth <no-reply@mail.example.com>
# Address shown to customers in emails for help.
# GLIDEWORTH_SUPPORT_EMAIL=support@example.com
# Mailgun transport only (GLIDEWORTH_EMAIL_TRANSPORT=mailgun): API key, sending domain, region (eu or us).
# GLIDEWORTH_MAILGUN_API_KEY=
# GLIDEWORTH_MAILGUN_DOMAIN=
# GLIDEWORTH_MAILGUN_REGION=eu
# Mailgun webhook signing key.
# GLIDEWORTH_MAILGUN_WEBHOOK_SIGNING_KEY=

# ---- Billing (Stripe) ----
# Gateway: fake (development only, in memory) or stripe. fake is refused in production.
# GLIDEWORTH_BILLING=fake
# Stripe secret key (sk_test_... in test mode). Used when GLIDEWORTH_BILLING=stripe.
# GLIDEWORTH_STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint (whsec_...).
# GLIDEWORTH_STRIPE_WEBHOOK_SECRET=
# Stripe customer-portal configuration id (bpc_...), created by `sync-prices --apply`.
# GLIDEWORTH_STRIPE_PORTAL_CONFIGURATION=

# ---- Sign-up protection (Cloudflare Turnstile) ----
# Turnstile secret key. Required in production.
# GLIDEWORTH_TURNSTILE_SECRET=
# Development only: the captcha token accepted when no Turnstile secret is set. Default dev-captcha.
# GLIDEWORTH_DEV_CAPTCHA_TOKEN=

# ---- Backups (S3-compatible object storage; DigitalOcean Spaces in the hosted deployment) ----
# Bucket for encrypted backups. Required in production; without it, development uses <data dir>/backup-store.
# GLIDEWORTH_S3_BUCKET=
# Endpoint of the object store, for example https://fra1.digitaloceanspaces.com
# GLIDEWORTH_S3_ENDPOINT=
# Region used for signing and as the region segment of backup keys, for example fra1.
# GLIDEWORTH_S3_REGION=
# GLIDEWORTH_S3_ACCESS_KEY_ID=
# GLIDEWORTH_S3_SECRET_ACCESS_KEY=

# ---- Sign in with Google (optional; being added, see packages/cloud/src/config.ts) ----
# OAuth client id and secret from Google Cloud Console. Set both or neither; with neither, there is no Google
# button. The redirect URI is fixed: <GLIDEWORTH_PUBLIC_URL>/api/v1/auth/google/callback.
# GLIDEWORTH_GOOGLE_CLIENT_ID=
# GLIDEWORTH_GOOGLE_CLIENT_SECRET=
# Another OpenID issuer, for tests with a local fake only. Refused in production.
# GLIDEWORTH_GOOGLE_ISSUER=
