# Read by oxfmt (in addition to .gitignore, which already excludes node_modules, dist and coverage).

# Anything private stays out of every tool
private/

# Lockfiles
pnpm-lock.yaml
infra/terraform/.terraform.lock.hcl

# Generated files and snapshots
apps/web/src/routeTree.gen.ts
packages/core/src/stochastic/data/*.generated.ts
apps/site/src/data/openapi.json
**/drizzle/
**/__snapshots__/
**/*.snap

# Generated by `pnpm --filter @glideworth/importers gen:mapping-doc`; export.test.ts compares it byte for byte
packages/importers/docs/projectionlab-mapping.md

# Test fixtures (byte-exact inputs)
**/test/fixtures/
**/tests/fixtures/

# Canonical licence and policy texts: must stay byte-identical to upstream
LICENSE
packages/importers/LICENSE
CODE_OF_CONDUCT.md

# Third-party notices (assembled from upstream licence texts)
THIRD-PARTY-NOTICES.md

# Historical documents
docs/research/
docs/LAUNCH-PLAN.md

# Source text that the build replaces by exact string match (apps/web/vite.config.ts, release.test.ts)
apps/web/public/sw.js

# Hand-tuned SVGs and binaries (oxfmt does not format them today; stated so a future version cannot)
**/*.svg
**/*.png
**/*.ico

# Astro files: oxfmt has no Astro support
**/*.astro

# MDX: oxfmt corrupts JSX components wrapped around Markdown (it dedents a <CodeBlock> out of a list item
# inside <Steps> and moves </Steps>), which breaks `astro build`; it also re-wraps <Callout> prose.
# apps/site/src/content is prose with components, so it is left as written.
**/*.mdx
