---
import { AE_DEWS, AE_GRATUITY, AE_SAVINGS_SCHEME, AE_SIMPLIFICATIONS, aeGratuity } from '@glideworth/core';
import ToolPage from '../../components/tools/ToolPage.astro';
import { externalLinkProps } from '../../lib/links';
import { CAP_YEARS, gratuityBreakdown, SAME_SCHEME_RATES, schemeValue } from '../../tools/engine/uae-gratuity';
import { money, pct } from '../../tools/format';

const g = AE_GRATUITY;
const s = AE_SAVINGS_SCHEME;
const m = (x: number) => money(x, 'AED');
const READ = '19 November 2026'; // the date core's UAE sources were checked (packages/core/src/tax/data/ae.ts)

// Worked example, computed by the calculator's own code at build time.
const wage = 10_000;
const ex = gratuityBreakdown(8, wage);
const exPart = gratuityBreakdown(3.5, wage);
const exScheme = schemeValue(8, wage, 0, 'mid');
const rows = [0.5, 1, 3, 5, 7.5, 10, 15, 20, 25, 30].map((y) => [
  String(y),
  m(aeGratuity(y, wage)),
  m(schemeValue(y, wage, 0, 'mid').value),
]);
const sources = [
  ...g.sources.map((x) => ({ ...x, label: 'UAE government portal: end of service benefits in the private sector' })),
  ...s.sources.slice(1).map((x) => ({ ...x, label: x.url.includes('faq') ? 'MOHRE: frequently asked questions' : 'MOHRE: voluntary alternative end-of-service benefits scheme' })),
  ...AE_DEWS.sources.map((x) => ({ ...x, label: x.url.includes('qualifying') ? 'DIFC: qualifying schemes (DEWS)' : 'DIFC Employment Law No. 2 of 2019' })),
];

const faq = [
  {
    q: 'How is end-of-service gratuity calculated in the UAE?',
    a: `<p>For an expatriate employee in the private sector: nothing under ${g.minYears} year of continuous service; ${g.daysFirstFiveYears} days of basic wage for each of the first ${g.firstTierYears} years; ${g.daysAfterFiveYears} days for each year after; part years pro rata once the first year is complete; and no more than ${g.capYearsOfWage} years of wage in total. ${ex.years} years on ${m(wage)} a month gives ${m(ex.gratuity)}.</p>`,
  },
  {
    q: 'Is gratuity based on basic salary or total salary?',
    a: '<p>On the last basic wage, without allowances, as the government portal publishes the rule. Whether the cap uses basic or total wage is not settled there; the calculator uses basic wage, the lower reading.</p>',
  },
  {
    q: 'How is the daily wage worked out?',
    a: `<p>The calculator divides the monthly basic wage by ${g.daysPerMonth}. That is Glideworth’s convention: the government portal gives the rule in days of wage but no daily-wage formula. Dividing the yearly basic wage by 365 instead gives a slightly smaller figure.</p>`,
  },
  {
    q: 'What changes if my employer uses the savings scheme or DEWS?',
    a: `<p>Under the voluntary savings scheme (and DEWS in the DIFC) your employer pays a share of your basic wage into a fund each month instead of a gratuity at the end: ${pct(s.employerRateUnder5Years, 2)} for the first ${g.firstTierYears} years and ${pct(s.employerRateFrom5Years, 2)} after. The fund is invested, and there is no cap. Do not count both: the scheme replaces the gratuity.</p>`,
  },
  {
    q: 'Do I get gratuity if I resign?',
    a: '<p>The calculator applies the rule as the government portal publishes it and does not reduce the gratuity for resignation. Reductions on resignation under the old law, unpaid leave days and limited-contract rules are not modelled.</p>',
  },
];
---

<ToolPage
  id="uae-gratuity"
  heading="UAE gratuity calculator: your end-of-service benefit"
  lede="Your end-of-service gratuity from years of service and your last basic wage, tier by tier with the cap, and what the same service would build under the savings scheme. It uses the Glideworth engine’s UAE rules in your browser; nothing you type is sent anywhere."
  faq={faq}
  adds="A gratuity is one payment at the end of a job; the full planner puts it in the year your salary ends."
  related={[
    { href: '/planning/ae/', label: 'Retirement planning in the United Arab Emirates' },
    { href: '/features/tax-estimates/', label: 'Tax estimates in the full planner' },
  ]}
>
  <h2>The rule</h2>
  <ul>
    <li>Under {g.minYears} year of continuous service: no gratuity.</li>
    <li>Years 1 to {g.firstTierYears}: {g.daysFirstFiveYears} days of basic wage for each year.</li>
    <li>Each year after {g.firstTierYears}: {g.daysAfterFiveYears} days of basic wage.</li>
    <li>Part years count pro rata once the first year is complete.</li>
    <li>The total may not exceed {g.capYearsOfWage} years of wage, reached after about {CAP_YEARS.toFixed(1)} years of service.</li>
  </ul>
  <p>
    This is Article 51 of the Labour Law (Federal Decree-Law No. 33 of 2021) for expatriate employees in the private sector,
    as the UAE government portal publishes it.
  </p>

  <h2>How the calculator works</h2>
  <ol>
    <li>
      <strong>Gratuity.</strong> The engine’s <code>aeGratuity</code>, the same function the planner uses on a salary,
      applied to your years of service and monthly basic wage. The daily wage is the monthly basic wage ÷
      {' '}{g.daysPerMonth}: Glideworth’s convention, because the government portal gives the rule in days of wage but no
      daily-wage formula.
    </li>
    <li>
      <strong>Savings scheme.</strong> The engine adds the employer’s contributions to one account: {pct(s.employerRateUnder5Years, 2)}
      {' '}of the monthly basic wage for the first {g.firstTierYears} years of service and {pct(s.employerRateFrom5Years, 2)}
      {' '}after{SAME_SCHEME_RATES ? ', the same rates for DEWS in the DIFC' : ''}. Set a return under “More options” to see the fund
      grow; at 0% it is the contributions alone.
    </li>
  </ol>

  <h2>The formula</h2>
  <p class="formula">
    gratuity = min(daily wage × ({g.daysFirstFiveYears} × min(Y, {g.firstTierYears}) + {g.daysAfterFiveYears} × max(0, Y −
    {' '}{g.firstTierYears})), {g.capYearsOfWage * 12} × monthly basic wage)
  </p>
  <p>
    <code>Y</code> is the years of service (0 below one year) and the daily wage is the monthly basic wage ÷
    {' '}{g.daysPerMonth}. The numbers in the formula are the engine’s: {g.daysFirstFiveYears} and {g.daysAfterFiveYears}
    {' '}days, the {g.firstTierYears}-year first tier and a cap of {g.capYearsOfWage * 12} months of wage.
  </p>

  <h2>Worked example</h2>
  <p>
    Computed by the calculator’s own code when this page was built. A final monthly basic wage of {m(wage)} after
    {' '}{ex.years} years of service:
  </p>
  <ul>
    <li>Daily wage: {m(wage)} ÷ {g.daysPerMonth} = AED {ex.daily.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}.</li>
    <li>
      Days of wage: {ex.firstYears} × {g.daysFirstFiveYears} = {ex.firstDays}, plus {ex.laterYears} × {g.daysAfterFiveYears} =
      {' '}{ex.laterDays}, so {ex.firstDays + ex.laterDays} days.
    </li>
    <li>Gratuity: {ex.firstDays + ex.laterDays} × {wage.toLocaleString('en-US')} ÷ {g.daysPerMonth} = <strong>{m(ex.gratuity)}</strong>.</li>
    <li>Cap: {g.capYearsOfWage * 12} × {m(wage)} = {m(ex.cap)}, {ex.capped ? 'which applies' : 'not reached'}.</li>
    <li>
      Part years: {exPart.years} years gives {exPart.firstDays} days and {m(exPart.gratuity)}.
    </li>
    <li>
      Under the savings scheme the employer would have paid {m(exScheme.contributions)} over the same {ex.years} years,
      before any investment return.
    </li>
  </ul>
  <div class="table-scroll" tabindex="0" role="group" aria-label="Table, scrolls sideways if it does not fit">
    <table>
      <caption>Gratuity and savings scheme contributions on {m(wage)} a month</caption>
      <thead><tr><th>Years of service</th><th>Gratuity</th><th>Scheme contributions</th></tr></thead>
      <tbody>{rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
    </table>
  </div>
  <p>
    The scheme’s rates track the gratuity closely for the first years; past the cap the gratuity stops growing and the
    scheme does not.
  </p>

  <h2>What this assumes and leaves out</h2>
  <ul>
    <li>
      Expatriate employees in the private sector under the federal Labour Law. In the DIFC, DEWS replaces the gratuity; UAE
      nationals are covered by GPSSA instead. Neither is calculated here beyond the scheme comparison.
    </li>
    <li>Continuous service as you enter it: unpaid absence does not count towards it, and the calculator does not subtract it for you.</li>
    <li>The same basic wage for the whole service in the scheme comparison. The gratuity uses your last basic wage.</li>
    <li>No reduction for resignation under the old law, unpaid leave days or limited-contract rules.</li>
    <li>The scheme’s return is the single rate you enter, with no fees; voluntary employee top-ups are not included.</li>
    <li>
      The engine’s UAE notes:
      <details>
        <summary>The UAE model’s simplifications ({AE_SIMPLIFICATIONS.length})</summary>
        <ul>{AE_SIMPLIFICATIONS.map((x) => <li>{x}</li>)}</ul>
      </details>
    </li>
  </ul>

  <h2>Sources</h2>
  <p>The rules and rates come from the engine’s UAE data, which cites these official pages (checked {READ}):</p>
  <ul>
    {sources.map((x) => <li><a href={x.url} {...externalLinkProps(x.url)}>{x.label}</a></li>)}
  </ul>
</ToolPage>
