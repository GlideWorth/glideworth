---
/**
 * A link into the public source repository (src/config/site.ts `repoUrl`), for MDX:
 *   <RepoLink path="LICENSING.md">LICENSING.md</RepoLink>     -> <repo>/blob/main/LICENSING.md
 *   <RepoLink>the repository</RepoLink>                       -> <repo>
 */
import { site } from '../config/site';
import { externalLinkProps } from '../lib/links';

interface Props {
  path?: string;
}
const { path } = Astro.props;
const href = path ? `${site.repoUrl}/blob/main/${path}` : site.repoUrl;
---

<a href={href} {...externalLinkProps(href)}><slot /></a>
