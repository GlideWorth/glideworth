---
/**
 * A framed figure: a screenshot, an image, or a diagram passed as children.
 *
 *   Screenshot (later wave): import shot from '../assets/screenshots/results-overview.png';
 *     <Figure screenshot="results-overview" src={shot} alt="…" caption="…" />
 *   Diagram until then:
 *     <Figure screenshot="results-overview" caption="…"><ProjectionFan /></Figure>
 *
 * `screenshot` names the slot. It is written to data-screenshot-slot so the screenshot wave can find
 * every place that wants a real capture: grep -r 'screenshot="' src. Without `src` the children render;
 * without either, a labelled empty frame renders (only in development, so it cannot ship by accident).
 */
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  caption?: string;
  /** Name of the screenshot slot, e.g. "results-overview". */
  screenshot?: string;
  width?: number;
  height?: number;
  /** "framed" adds the window chrome; "plain" is just the image. */
  frame?: 'framed' | 'plain';
  /** Load eagerly (above the fold). */
  eager?: boolean;
  class?: string;
}
const {
  src,
  alt = '',
  caption,
  screenshot,
  width,
  height,
  frame = 'framed',
  eager = false,
  class: className,
} = Astro.props;
const img =
  typeof src === 'string'
    ? { src, width, height }
    : src
      ? { src: src.src, width: src.width, height: src.height }
      : undefined;
const hasChildren = Astro.slots.has('default');
const showEmpty = !img && !hasChildren && import.meta.env.DEV;
---

<figure class:list={['figure', `figure-${frame}`, className]} data-screenshot-slot={screenshot}>
  <div class="figure-frame">
    {
      img ? (
        <img
          src={img.src}
          alt={alt}
          width={img.width}
          height={img.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : hasChildren ? (
        <slot />
      ) : (
        showEmpty && (
          <div class="figure-empty">
            Screenshot slot <code>{screenshot ?? 'unnamed'}</code>
          </div>
        )
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    display: grid;
    gap: var(--space-xs);
  }
  .figure-framed .figure-frame {
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .figure-frame img {
    width: 100%;
    height: auto;
  }
  .figure-empty {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border: 2px dashed var(--line-strong);
    border-radius: var(--radius-l);
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  figcaption {
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.5;
  }
</style>
