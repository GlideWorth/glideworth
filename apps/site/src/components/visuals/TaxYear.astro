---
/**
 * One plan year's tax, as the product lays it out: lines by kind and level, plus the model's own
 * list of what it leaves out. The amounts are the 2034 year (future dollars) of the synthetic US
 * sample household (createSampleDocument in packages/core: a married couple filing jointly in
 * Colorado) with its tax switched from flat rates to the full estimate, rounded to the dollar.
 * They move when the engine or the tax tables change, so the visual calls them illustrative.
 * The "leaves out" lines are real entries from the US simplifications (packages/core/src/tax/data/anglo.ts).
 */
import { facts } from '../../lib/facts';

const lines = [
  { label: 'Federal income tax', level: 'Federal', amount: 24_539 },
  { label: 'Qualified dividends tax', level: 'Federal', amount: 740 },
  { label: 'Child tax credit', level: 'Federal', amount: -2_734 },
  { label: 'Social Security tax', level: 'Payroll', amount: 14_433 },
  { label: 'Medicare tax', level: 'Payroll', amount: 3_376 },
  { label: 'Colorado income tax', level: 'State', amount: 7_720 },
];
const total = lines.reduce((s, l) => s + l.amount, 0);
const usd = (n: number) => `${n < 0 ? '−' : ''}$${Math.abs(n).toLocaleString('en-US')}`;
const leavesOut = [
  'The SALT cap and limits on itemised deductions are not applied automatically',
  'No earned income, education or child and dependent care credits',
  'Employer payroll taxes are not modelled',
];
const listed =
  facts.simplificationCount('us-federal') +
  facts.simplificationCount('us-payroll') +
  facts.simplificationCount('us-state');
---

<div class="taxyear">
  <div class="ty-head">
    <p class="ty-title">Tax in 2034 <span class="ty-sub">United States, married filing jointly in Colorado</span></p>
    <p class="ty-flag">Illustrative amounts</p>
  </div>
  <table>
    <caption class="visually-hidden">Illustrative tax lines for one plan year</caption>
    <thead>
      <tr><th scope="col">Line</th><th scope="col">Level</th><th scope="col" class="r">Amount</th></tr>
    </thead>
    <tbody>
      {
        lines.map((l) => (
          <tr>
            <td>{l.label}</td>
            <td>{l.level}</td>
            <td class="r num">{usd(l.amount)}</td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr><th scope="row" colspan="2">Total</th><td class="r num">{usd(total)}</td></tr>
    </tfoot>
  </table>
  <div class="leaves">
    <p class="leaves-title">What this estimate leaves out <span class="muted">(3 of {listed} shown)</span></p>
    <ul>
      {leavesOut.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</div>

<style>
  .taxyear {
    padding: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    background: var(--surface);
    display: grid;
    gap: 1rem;
  }
  .ty-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
  }
  .ty-title {
    font-weight: 640;
    font-size: var(--text-sm);
  }
  .ty-sub {
    display: block;
    font-weight: 400;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .ty-flag {
    font-size: var(--text-xs);
    color: var(--ink-3);
    font-style: italic;
  }
  table {
    font-size: var(--text-sm);
  }
  th,
  td {
    text-align: left;
    padding: 0.45rem 0.5rem 0.45rem 0;
    border-bottom: 1px solid var(--line);
  }
  thead th {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
  tfoot th,
  tfoot td {
    border-bottom: 0;
    font-weight: 650;
  }
  .r {
    text-align: right;
    padding-right: 0;
  }
  .leaves {
    border-radius: var(--radius-m);
    background: var(--ochre-soft);
    padding: 0.75rem 0.9rem;
    font-size: var(--text-xs);
    color: var(--ink);
  }
  .leaves-title {
    font-weight: 650;
    margin-bottom: 0.35rem;
  }
  .leaves-title .muted {
    color: var(--ink-2);
    font-weight: 400;
  }
  .leaves ul {
    padding-left: 1.1em;
    display: grid;
    gap: 0.2rem;
  }
</style>
