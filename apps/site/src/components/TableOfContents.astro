---
/**
 * "On this page" list from the headings Astro returns when rendering an entry:
 *   const { Content, headings } = await render(entry);
 *   <TableOfContents headings={headings} />
 * Shows h2 and h3 by default; renders nothing when there are fewer than two headings.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  maxDepth?: 2 | 3 | 4;
  title?: string;
}
const { headings, maxDepth = 3, title = 'On this page' } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= maxDepth);
---

{
  items.length >= 2 && (
    <nav class="toc" aria-labelledby="toc-title">
      <p id="toc-title" class="toc-title">
        {title}
      </p>
      <ol role="list">
        {items.map((h) => (
          <li class={`depth-${h.depth}`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    font-size: var(--text-sm);
  }
  .toc-title {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.6rem;
  }
  ol {
    display: grid;
    gap: 0.45rem;
    border-left: 1px solid var(--line);
  }
  li {
    padding-left: 0.85rem;
    line-height: 1.4;
  }
  .depth-3 {
    padding-left: 1.6rem;
  }
  .depth-4 {
    padding-left: 2.3rem;
  }
  a {
    color: var(--ink-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--accent-text);
  }
</style>
