---
/**
 * "Related" links for the current page, from the clusters in src/config/related.ts. Used by EntryLayout and
 * DocsLayout, so feature pages, docs, country pages, comparisons and blog posts link to each other without
 * links being written into every page.
 */
import { relatedFor } from '../lib/related';

const links = await relatedFor(Astro.url.pathname);
---

{
  links.length > 0 && (
    <nav class="related" aria-labelledby="related-title">
      <h2 id="related-title">Related</h2>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.title}</a> <span class="kind">{l.kind}</span>
            </li>
          ))
        }
      </ul>
    </nav>
  )
}

<style>
  .related {
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }
  .related h2 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-xs);
  }
  .related ul {
    display: grid;
    gap: 0.4rem;
    font-size: var(--text-sm);
  }
  .kind {
    margin-left: 0.4rem;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
</style>
