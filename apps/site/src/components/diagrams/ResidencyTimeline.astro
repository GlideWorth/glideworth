---
/**
 * A residency timeline for a two-person household, drawn as strips over the plan's years. The people,
 * countries and dates are ILLUSTRATIVE; the idea (dated moves per person, a split year prorated by
 * month) is what the engine models.
 */
const x0 = 96;
const x1 = 584;
const years = [2026, 2034, 2046, 2056];
const span = years[3]! - years[0]!;
const xAt = (y: number) => x0 + ((y - years[0]!) / span) * (x1 - x0);
const strips = [
  {
    who: 'Alex',
    y: 46,
    parts: [
      [2026, 2034, 'UK'],
      [2034, 2046, 'UAE'],
      [2046, 2056, 'UK'],
    ],
  },
  {
    who: 'Sam',
    y: 88,
    parts: [
      [2026, 2034.25, 'UK'],
      [2034.25, 2046, 'UAE'],
      [2046, 2056, 'UK'],
    ],
  },
] as const;
---

<figure class="rt">
  <svg viewBox="0 0 620 150" role="img" aria-label="Illustrative residency timeline: Alex moves from the UK to the UAE in 2034 and back in 2046; Sam moves three months later.">
    {
      strips.map((s) => (
        <g>
          <text x="0" y={s.y + 4} class="who">{s.who}</text>
          {s.parts.map(([a, b, c]) => (
            <g>
              <rect x={xAt(a)} y={s.y - 14} width={xAt(b) - xAt(a) - 2} height="28" rx="4" class={c === 'UK' ? 'uk' : 'ae'} />
              <text x={(xAt(a) + xAt(b)) / 2 - 1} y={s.y + 4} text-anchor="middle" class="lab">{c}</text>
            </g>
          ))}
        </g>
      ))
    }
    {years.map((y) => (
      <g>
        <line x1={xAt(y)} x2={xAt(y)} y1="24" y2="114" class="grid" />
        <text x={xAt(y)} y="134" text-anchor="middle" class="tick">{y}</text>
      </g>
    ))}
    <text x={xAt(2034.12)} y="16" text-anchor="middle" class="note">split year, prorated by month</text>
  </svg>
  <figcaption>Illustrative. Each person has their own dated moves; the move year is split by month.</figcaption>
</figure>

<style>
  .rt {
    padding: clamp(0.75rem, 0.6rem + 1vw, 1.25rem);
    background: var(--surface);
    display: grid;
    gap: 0.4rem;
  }
  svg {
    width: 100%;
    height: auto;
  }
  .who {
    font: 600 12px var(--font-sans);
    fill: var(--ink);
  }
  .lab {
    font: 600 11px var(--font-sans);
    fill: var(--ink);
  }
  .tick {
    font: 11px var(--font-sans);
    fill: var(--ink-3);
  }
  .note {
    font: italic 10px var(--font-sans);
    fill: var(--ink-3);
  }
  .grid {
    stroke: var(--line);
    stroke-dasharray: 2 3;
  }
  .uk {
    fill: var(--accent-soft);
    stroke: var(--accent-text);
    stroke-width: 1;
  }
  .ae {
    fill: var(--ochre-soft);
    stroke: var(--ochre);
    stroke-width: 1;
  }
  figcaption {
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--ink-3);
  }
</style>
