---
/**
 * Legal-page wording for the optional marketing-site tag. A build without PUBLIC_GTM_ID keeps
 * the original "no analytics" text. The official hosted build describes the tag it actually loads.
 */
import { PUBLIC_GTM_ID, PUBLIC_POSTHOG_HOST, PUBLIC_POSTHOG_PROJECT_TOKEN } from "astro:env/server";
import { googleTagManagerId } from "../lib/gtm";
import { sitePostHog } from "../lib/posthog";
import Callout from "./Callout.astro";
import MdxTable from "./MdxTable.astro";

interface Props {
  part: "cookies-callout" | "cookies-site" | "cookies-analytics" | "cookies-consent" | "privacy";
}

const { part } = Astro.props;
const hosted = googleTagManagerId(PUBLIC_GTM_ID) !== undefined;
// The official hosted build also measures marketing pages, calculators included, with PostHog, cookieless and
// without calculator inputs or results (src/lib/posthog.ts, src/lib/posthog-scrub.ts).
const posthogSite = sitePostHog(PUBLIC_POSTHOG_PROJECT_TOKEN, PUBLIC_POSTHOG_HOST) !== undefined;
const siteAnalytics =
  "The marketing pages, the free calculators included, also send page views, page leaves, clicks and where on the page they land, scroll depth, page load timings, the referring site and campaign tags, browser and device details, and your IP address to PostHog, through this website's own address. Page addresses and the referring address lose any query string or fragment first. Calculator inputs and results are not included: a calculator keeps your inputs in its page address, which loses them, and on calculator pages the text of what you click is left out too. PostHog runs here without cookies or any browser storage: it tells visits apart with a daily hash of your IP address and browser details, computed on PostHog's servers. It records no session recordings on these pages.";
const appAnalytics =
  "The hosted app (app.glideworth.com) uses PostHog for product analytics, session recordings and error reports: which pages and features are used, recordings of what the app shows and how it is used (form fields masked), and errors in the app. It keeps a random identifier in local storage under a key starting with ph_ and sets no cookie. Signed-in users are linked to their account id, email address and name. The free calculators load no advertising or session-recording tools, and a self-hosted copy loads no analytics, advertising or session-recording tools.";
---

{
  part === "cookies-callout" &&
    (hosted ? (
      <Callout type="note" title="The short version">
        <p>
          This website loads Google Tag Manager on marketing pages. It sets{" "}
          <strong>Google Analytics cookies only if you accept them</strong> in the banner, and{" "}
          <strong>never advertising cookies</strong>. You can change your answer with "Cookie settings" at
          the foot of any page. The signed-in app and the free calculators do not load the tag. The hosted
          app uses PostHog for product analytics and error reports (section 3). A self-hosted copy of this
          website leaves the setting empty and loads nothing from Google.
        </p>
      </Callout>
    ) : (
      <Callout type="note" title="The short version">
        <p>
          This website sets <strong>no cookies</strong>. The app sets <strong>sign-in and security cookies</strong>{" "}
          that it cannot work without, and keeps some settings and unsaved drafts in your browser's local
          storage. The hosted app also keeps a PostHog analytics identifier in local storage (section 3).
          There are <strong>no advertising cookies</strong>.
        </p>
      </Callout>
    ))
}

{
  part === "cookies-site" &&
    (hosted ? (
      <>
      <p>
        The pages also load Google Tag Manager from <code>www.googletagmanager.com</code>. The official
        hosted website is built with a container id; a self-hosted copy is not, unless you set one
        yourself. The container measures page views with Google Analytics. Until you accept in the banner,
        Google is instructed not to write any analytics or advertising cookie, though loading the script
        still sends your IP address and the page address to Google. The calculator pages, where you type
        figures, do not load the tag, and the signed-in app does not either.
      </p>
      {posthogSite && <p>{siteAnalytics}</p>}
      <MdxTable>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Purpose</th>
            <th>Lifetime</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <code>glideworth-consent</code>
            </td>
            <td>Local storage (not a cookie)</td>
            <td>Remembers whether you accepted or rejected analytics cookies, so the banner does not ask again.</td>
            <td>12 months, then the banner asks again</td>
          </tr>
          <tr>
            <td>
              <code>_ga</code>, <code>_ga_*</code>
            </td>
            <td>Cookie (Google Analytics)</td>
            <td>Counts visits and pages viewed. Set only after you accept analytics cookies.</td>
            <td>2 years</td>
          </tr>
        </tbody>
      </MdxTable>
      </>
    ) : (
      <p>
        That is all. The site has no analytics, no advertising, no embedded third-party content, no social
        media buttons, and no fonts or scripts loaded from other companies. The pages themselves make no
        third-party requests.
      </p>
    ))
}

{
  part === "cookies-analytics" &&
    (hosted ? (
      <p>
        The marketing website uses Google Analytics, through Google Tag Manager, to count visits (section
        1). Its cookies are set only if you accept them in the banner. It sets no advertising cookies.{" "}
        {posthogSite && <>{siteAnalytics} </>}
        {appAnalytics}
      </p>
    ) : (
      <p>
        The website uses none. {appAnalytics}
      </p>
    ))
}

{
  part === "cookies-consent" &&
    (hosted ? (
      <p>
        The UK and EU rules on cookies and similar technologies (PECR and the ePrivacy Directive) require
        consent before storage on your device, unless the storage is strictly necessary to provide
        something you asked for. The sign-in and anti-forgery cookies are strictly necessary, and so are
        the Google sign-in cookies, which exist only while a sign-in you started is in progress. The
        device and sign-up cookies and the bot check exist only to keep your account secure. The remaining storage
        keeps your own settings and drafts, and the website's theme choice is set by you. Google Analytics
        cookies on the marketing website are not strictly necessary, so the website asks first: they are
        set only after you press "Accept analytics", and "Reject" is just as easy. Advertising storage is
        never granted. You can change your answer at any time with "Cookie settings" at the foot of any
        page, and the website asks again after 12 months. The hosted app's PostHog identifier (section 3)
        is analytics storage too, and there is no consent prompt for it yet.
      </p>
    ) : (
      <p>
        The UK and EU rules on cookies and similar technologies (PECR and the ePrivacy Directive) require
        consent for storage on your device unless it is strictly necessary to give you something you asked
        for. The sign-in and anti-forgery cookies are strictly necessary, and so are the Google sign-in
        cookies, which exist only while a sign-in you started is in progress. The device and sign-up cookies and the
        bot check exist only to keep your account secure. The remaining storage keeps your own settings
        and drafts for you, and the website's theme choice is set by you. The hosted app's PostHog
        identifier (section 3) is analytics storage, and there is no consent prompt for it yet. We use no
        advertising technology.
      </p>
    ))
}

{
  part === "privacy" &&
    (hosted ? (
      <>
      <p>
        See the <a href="/legal/cookies/">cookie policy</a>. The official hosted marketing site loads
        Google Tag Manager and measures page views with Google Analytics. Analytics cookies are set only
        if you accept them in the cookie banner, and advertising cookies never are. Loading the script
        does send your IP address and the page address to Google, also before you choose. The signed-in
        app does not load the tag, and the free calculators do not either. A website you build yourself
        does not load it when the container id is left unset, which is the default.
      </p>
      {posthogSite && <p>{siteAnalytics}</p>}
      </>
    ) : (
      <p>
        See the <a href="/legal/cookies/">cookie policy</a>. In short: the marketing site sets no cookies.
        The app sets sign-in cookies that it needs to work, and stores some settings in your browser.
        There are no advertising or analytics cookies, and so no consent banner. If that ever changes, we
        will ask for your consent first.
      </p>
    ))
}
