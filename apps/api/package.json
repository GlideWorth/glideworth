{
  "name": "@glideworth/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@glideworth/source --env-file-if-exists=../../.env src/server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env dist/server.js",
    "mcp:stdio": "tsx --conditions=@glideworth/source --env-file-if-exists=../../.env src/mcp/stdio.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "keys:create": "tsx --conditions=@glideworth/source --env-file-if-exists=../../.env src/cli/create-key.ts",
    "cli": "tsx --conditions=@glideworth/source --env-file-if-exists=../../.env src/cli/admin.ts",
    "backup": "pnpm cli backup",
    "restore": "pnpm cli restore",
    "seed": "pnpm cli seed"
  },
  "dependencies": {
    "@glideworth/cloud": "workspace:*",
    "@glideworth/core": "workspace:*",
    "@glideworth/importers": "workspace:*",
    "@hono/node-server": "2.1.8",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@scalar/hono-api-reference": "0.12.21",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@glideworth/billing": "workspace:*",
    "@glideworth/email": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
