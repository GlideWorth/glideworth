---
import { type CollectionEntry, getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { publishedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return (await getCollection('authors')).map((author) => ({
    params: { id: author.id },
    props: { author, posts: posts.filter((p) => p.data.author.some((a) => a.id === author.id)) },
  }));
}
interface Props {
  author: CollectionEntry<'authors'>;
  posts: CollectionEntry<'blog'>[];
}
const { author, posts } = Astro.props;
const a = author.data;
---

<PageLayout
  title={a.name}
  description={a.bio}
  heading={a.name}
  eyebrow={a.role ?? 'Author'}
  lede={a.bio}
  crumbs={[
    { label: 'Blog', href: '/blog/' },
    { label: a.name, href: `/authors/${author.id}/` },
  ]}
>
  <div class="container body">
    <h2 class="visually-hidden">Articles</h2>
    <PostList posts={posts} />
  </div>
</PageLayout>

<style>
  .body {
    padding-bottom: var(--section-y);
  }
</style>
