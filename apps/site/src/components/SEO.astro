---
/**
 * Everything search engines and link previews read: title, description, canonical, robots, Open Graph,
 * Twitter and JSON-LD. BaseLayout renders it; pages pass their values to the layout, not to this.
 */
import { absoluteUrl, site } from '../config/site';
import { graph, type JsonLdObject } from '../lib/jsonld';
import { DEFAULT_OG_PATH, ogEntries, ogImagePath } from '../lib/og';
import JsonLd from './JsonLd.astro';

export interface SeoProps {
  title: string;
  description: string;
  /** Use the title as the whole <title> (no " · Glideworth"). */
  fullTitle?: boolean;
  /** Site path of the canonical page. Defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** For articles. */
  published?: Date;
  modified?: Date;
  /** Override the social image (site path). Defaults to the page's generated image. */
  image?: string;
  imageAlt?: string;
  /** JSON-LD nodes for this page; they are combined into one @graph. */
  jsonLd?: JsonLdObject[];
}

const {
  title,
  description,
  fullTitle = false,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  type = 'website',
  published,
  modified,
  image,
  imageAlt,
  jsonLd = [],
} = Astro.props as SeoProps;

const fullTitleText = fullTitle ? title : `${title} · ${site.name}`;
const canonical = absoluteUrl(canonicalPath);
const known = new Set((await ogEntries()).map((e) => e.path));
const imagePath = image ?? (known.has(canonicalPath) ? ogImagePath(canonicalPath) : DEFAULT_OG_PATH);
const imageUrl = absoluteUrl(imagePath);

if (import.meta.env.DEV && description.length > 170) {
  console.warn(`[seo] description over 170 characters on ${canonicalPath}`);
}
---

<title>{fullTitleText}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitleText} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? title} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitleText} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />

{jsonLd.length > 0 && <JsonLd data={graph(jsonLd)} />}
