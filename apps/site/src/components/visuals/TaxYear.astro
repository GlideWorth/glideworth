---
/**
 * One plan year's tax, as the product lays it out: lines by kind and level, plus the model's own
 * list of what it leaves out. With no props it shows the United States example of the home page
 * (src/landing/countries/us.ts says where its amounts come from); a country landing page passes its own
 * example (worked out by the engine at build time) and its currency.
 *   <TaxYear />  or  <TaxYear example={entry.working.taxYear} money={entry.money} />
 */
import { us } from '../../landing/countries/us';
import { formatMoney } from '../../landing/tax-example';
import type { Money, TaxYearExample } from '../../landing/types';

interface Props {
  example?: TaxYearExample;
  money?: Money;
}
const { example = us.working.taxYear!, money = us.money } = Astro.props;
const lines = example.lines;
const total = lines.reduce((s, l) => s + l.amount, 0);
const fmt = (n: number) => formatMoney(n, money);
const leavesOut = example.leavesOut;
const listed = example.listed;
---

<div class="taxyear">
  <div class="ty-head">
    <p class="ty-title">{example.title} <span class="ty-sub">{example.subtitle}</span></p>
    <p class="ty-flag">Illustrative amounts</p>
  </div>
  <table>
    <caption class="visually-hidden">Illustrative tax lines for one plan year</caption>
    <thead>
      <tr><th scope="col">Line</th><th scope="col">{example.levelHeading}</th><th scope="col" class="r">Amount</th></tr>
    </thead>
    <tbody>
      {
        lines.map((l) => (
          <tr>
            <td>{l.label}</td>
            <td>{l.level}</td>
            <td class="r num">{fmt(l.amount)}</td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr><th scope="row" colspan="2">Total</th><td class="r num">{fmt(total)}</td></tr>
    </tfoot>
  </table>
  <div class="leaves">
    <p class="leaves-title">What this estimate leaves out <span class="muted">({leavesOut.length} of {listed} shown)</span></p>
    <ul>
      {leavesOut.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</div>

<style>
  .taxyear {
    padding: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    background: var(--surface);
    display: grid;
    gap: 1rem;
  }
  .ty-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
  }
  .ty-title {
    font-weight: 640;
    font-size: var(--text-sm);
  }
  .ty-sub {
    display: block;
    font-weight: 400;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }
  .ty-flag {
    font-size: var(--text-xs);
    color: var(--ink-3);
    font-style: italic;
  }
  table {
    font-size: var(--text-sm);
  }
  th,
  td {
    text-align: left;
    padding: 0.45rem 0.5rem 0.45rem 0;
    border-bottom: 1px solid var(--line);
  }
  thead th {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-3);
  }
  tfoot th,
  tfoot td {
    border-bottom: 0;
    font-weight: 650;
  }
  .r {
    text-align: right;
    padding-right: 0;
  }
  .leaves {
    border-radius: var(--radius-m);
    background: var(--ochre-soft);
    padding: 0.75rem 0.9rem;
    font-size: var(--text-xs);
    color: var(--ink);
  }
  .leaves-title {
    font-weight: 650;
    margin-bottom: 0.35rem;
  }
  .leaves-title .muted {
    color: var(--ink-2);
    font-weight: 400;
  }
  .leaves ul {
    padding-left: 1.1em;
    display: grid;
    gap: 0.2rem;
  }
</style>
