---
/** A list of blog posts with date, title, description and tags. Used by /blog/, tag and author pages. */
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, tagSlug } from '../lib/content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">No articles yet.</p>
  ) : (
    <ol class="posts" role="list">
      {posts.map((p) => (
        <li class="post">
          <time datetime={isoDate(p.data.pubDate)}>{formatDate(p.data.pubDate)}</time>
          <div>
            <h2 class="post-title">
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              {p.data.draft && <span class="draft">Draft</span>}
            </h2>
            <p class="post-desc">{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <ul class="tags" role="list">
                {p.data.tags.map((t) => (
                  <li>
                    <a href={`/blog/tags/${tagSlug(t)}/`}>{t}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .posts {
    border-top: 1px solid var(--line-strong);
  }
  .post {
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .post {
      grid-template-columns: 11rem 1fr;
    }
  }
  time {
    color: var(--ink-3);
    font-size: var(--text-sm);
    padding-top: 0.3rem;
  }
  .post-title {
    font-size: var(--text-xl);
  }
  .post-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post-title a:hover {
    color: var(--accent-text);
  }
  .post-desc {
    margin-top: 0.4rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .tags a {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: var(--text-xs);
    text-decoration: none;
  }
  .tags a:hover {
    color: var(--ink);
    border-color: var(--ink-3);
  }
  .draft {
    margin-left: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--ochre);
  }
  .empty {
    color: var(--ink-3);
  }
</style>
