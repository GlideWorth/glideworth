{
  "name": "@glideworth/site",
  "version": "0.1.0",
  "private": true,
  "description": "The Glideworth marketing site (glideworth.com): static Astro build.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 4321",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "check:dist": "node scripts/check-dist.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "snapshot:openapi": "node scripts/snapshot-openapi.mjs",
    "snapshot:dates": "node scripts/snapshot-source-dates.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.5",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@glideworth/cloud": "workspace:*",
    "@glideworth/core": "workspace:*",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "satori": "0.63.2",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
