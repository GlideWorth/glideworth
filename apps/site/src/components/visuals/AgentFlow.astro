---
/**
 * Diagram of an AI assistant working on a plan over MCP: a question, the tools it calls (real tool
 * names from docs/MCP.md), and a change set the person approves. Figures in the change set are
 * illustrative and labelled so.
 */
const tools = [
  { name: 'get_plan_summary', note: 'reads the plan' },
  { name: 'preview_changes', note: 'tries retiring at 57, stores nothing' },
  { name: 'run_monte_carlo', note: 'chance of success, before and after' },
  { name: 'propose_change_set', note: 'writes a proposal, applies nothing' },
];
---

<div class="flow" role="group" aria-label="How an AI assistant proposes a change over MCP">
  <ol class="flow-steps" role="list">
    <li class="step">
      <p class="step-label"><span class="n">1</span>You ask</p>
      <p class="bubble">“What if I retire three years earlier? Show me what it does to my chance of success.”</p>
    </li>
    <li class="step">
      <p class="step-label"><span class="n">2</span>Your assistant calls Glideworth's MCP tools</p>
      <ul class="tools" role="list">
        {
          tools.map((t) => (
            <li>
              <code>{t.name}</code>
              <span>{t.note}</span>
            </li>
          ))
        }
      </ul>
    </li>
    <li class="step">
      <p class="step-label"><span class="n">3</span>You review the proposal</p>
      <div class="changeset">
        <p class="cs-head">
          <span>Change set</span><span class="cs-status">Proposed</span>
        </p>
        <dl class="cs-rows">
          <div><dt>Retirement age</dt><dd><s>60</s> 57</dd></div>
          <div><dt>Chance of success</dt><dd><s>86%</s> 74%</dd></div>
        </dl>
        <p class="cs-actions" aria-hidden="true"><span class="cs-apply">Apply</span><span class="cs-discard">Discard</span></p>
        <p class="cs-note">Illustrative figures</p>
      </div>
    </li>
  </ol>
</div>

<style>
  .flow {
    padding: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    background: var(--surface);
  }
  .flow-steps {
    display: grid;
    gap: 1.1rem;
  }
  .step {
    display: grid;
    gap: 0.55rem;
    position: relative;
  }
  .step + .step {
    padding-top: 1.1rem;
    border-top: 1px dashed var(--line-strong);
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--ink-2);
    letter-spacing: 0.01em;
  }
  .n {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.7rem;
  }
  .bubble {
    padding: 0.7rem 0.9rem;
    background: var(--surface-2);
    border-radius: 12px 12px 12px 4px;
    font-size: var(--text-sm);
    color: var(--ink);
  }
  .tools {
    display: grid;
    gap: 0.35rem;
  }
  .tools li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .tools code {
    font-size: 0.78rem;
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--accent-text);
  }
  .changeset {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-m);
    padding: 0.8rem 0.9rem;
    display: grid;
    gap: 0.6rem;
    background: var(--bg);
  }
  .cs-head {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-weight: 650;
  }
  .cs-status {
    color: var(--ochre);
    background: var(--ochre-soft);
    border-radius: 999px;
    padding: 0 0.5rem;
  }
  .cs-rows {
    display: grid;
    gap: 0.3rem;
    font-size: var(--text-sm);
  }
  .cs-rows div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .cs-rows dt {
    color: var(--ink-2);
  }
  .cs-rows dd {
    font-variant-numeric: tabular-nums;
    font-weight: 620;
  }
  .cs-rows s {
    color: var(--ink-3);
    font-weight: 400;
    margin-right: 0.35rem;
  }
  .cs-actions {
    display: flex;
    gap: 0.5rem;
  }
  .cs-actions span {
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }
  .cs-apply {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .cs-discard {
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }
  .cs-note {
    font-size: 0.72rem;
    color: var(--ink-3);
    font-style: italic;
  }
</style>
