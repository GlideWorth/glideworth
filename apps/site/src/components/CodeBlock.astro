---
/**
 * Highlighted code with an optional title and a copy button. Fenced code in Markdown and MDX gets the
 * same colours automatically; use this component when you need a title or code from a variable.
 *   <CodeBlock lang="bash" title="Terminal" code={`docker compose up -d --build`} />
 */
import { Code } from 'astro:components';
import { shikiDark, shikiLight } from '../lib/shiki-theme';

type CodeProps = Parameters<typeof Code>[0];
interface Props {
  code: string;
  lang?: CodeProps['lang'];
  title?: string;
  /** Show the copy button. */
  copy?: boolean;
}
const { code, lang = 'plaintext', title, copy = true } = Astro.props;
---

<figure class="codeblock">
  {
    (title || copy) && (
      <figcaption class="codeblock-bar">
        <span class="codeblock-title">{title ?? lang}</span>
        {copy && (
          <button type="button" class="codeblock-copy" data-copy hidden>
            Copy
          </button>
        )}
      </figcaption>
    )
  }
  <Code code={code.trim()} lang={lang} themes={{ light: shikiLight, dark: shikiDark }} defaultColor={false} />
</figure>

<script>
  // Progressive enhancement: the button only appears when the Clipboard API is available.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    if (!navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      const code = button.closest('figure')?.querySelector('pre')?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
      }, 1800);
    });
  }
</script>

<style>
  .codeblock {
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--code-bg);
  }
  /* The global reset zeroes margins, and outside .prose nothing spaces blocks apart, so the block
     brings its own gap from whatever sits above and below it. */
  :global(*) + .codeblock {
    margin-block-start: var(--space-m);
  }
  .codeblock + :global(*) {
    margin-block-start: var(--space-m);
  }
  .codeblock :global(pre) {
    border: 0;
    border-radius: 0;
    margin: 0;
  }
  .codeblock-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
    padding: 0.45rem 0.6rem 0.45rem 1rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .codeblock-title {
    font-family: var(--font-mono);
  }
  .codeblock-copy {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-2);
    border-radius: var(--radius-s);
    padding: 0.2rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: 600;
  }
  @media (pointer: coarse) {
    .codeblock-copy {
      min-height: 2.75rem;
      padding-inline: 0.9rem;
    }
  }
  .codeblock-copy:hover {
    color: var(--ink);
  }
</style>
