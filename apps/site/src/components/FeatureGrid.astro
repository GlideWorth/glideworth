---
/**
 * A grid of short feature descriptions. Each item may have a link and a small glyph.
 *   <FeatureGrid items={[{ title: 'Monte Carlo', body: '…', href: '/features/monte-carlo/', glyph: 'fan' }]} />
 * Glyphs are drawn here in SVG so the grid needs no icon library: fan, ledger, globe, solver, plug,
 * branch, lock, import, people, code.
 */
import { externalLinkProps } from '../lib/links';
export interface FeatureItem {
  title: string;
  body: string;
  href?: string;
  glyph?: 'fan' | 'ledger' | 'globe' | 'solver' | 'plug' | 'branch' | 'lock' | 'import' | 'people' | 'code';
}
interface Props {
  items: FeatureItem[];
  columns?: 2 | 3 | 4;
  /** Heading level for item titles. */
  as?: 'h2' | 'h3' | 'h4';
}
const { items, columns = 3, as: Heading = 'h3' } = Astro.props;

const glyphs: Record<NonNullable<FeatureItem['glyph']>, string> = {
  fan: '<path d="M3 16c4-1 7-4 9-9" /><path d="M3 16c4 0 8-2 13-4" opacity=".55"/><path d="M3 16c4 .5 9 0 14 .5" opacity=".3"/>',
  ledger: '<rect x="3.5" y="3.5" width="13" height="13" rx="2"/><path d="M3.5 8h13M3.5 12h13M9 8v8.5"/>',
  globe:
    '<circle cx="10" cy="10" r="6.5"/><path d="M3.5 10h13M10 3.5c2 2 2.8 4.2 2.8 6.5S12 14.5 10 16.5M10 3.5C8 5.5 7.2 7.7 7.2 10S8 14.5 10 16.5"/>',
  solver:
    '<circle cx="10" cy="10" r="6.5"/><circle cx="10" cy="10" r="2.5"/><path d="M10 1.5v3M10 15.5v3M1.5 10h3M15.5 10h3"/>',
  plug: '<path d="M7 3v4M13 3v4M5 7h10v2a5 5 0 0 1-10 0V7ZM10 14v3.5"/>',
  branch:
    '<circle cx="6" cy="4.5" r="1.8"/><circle cx="6" cy="15.5" r="1.8"/><circle cx="14" cy="8" r="1.8"/><path d="M6 6.3v7.4M14 9.8c0 3-3 3.2-8 4"/>',
  lock: '<rect x="4" y="9" width="12" height="8" rx="2"/><path d="M7 9V6.5a3 3 0 0 1 6 0V9"/>',
  import: '<path d="M10 3v9M6.5 8.5 10 12l3.5-3.5M4 14v2.5h12V14"/>',
  people:
    '<circle cx="7.5" cy="7" r="2.5"/><circle cx="13.5" cy="8" r="2"/><path d="M3 16c.6-2.6 2.4-4 4.5-4s3.9 1.4 4.5 4M12.5 12.2c1.9-.3 3.6.9 4.2 3.3"/>',
  code: '<path d="m7.5 6-4 4 4 4M12.5 6l4 4-4 4"/>',
};
---

<ul class:list={['feature-grid', `cols-${columns}`]} role="list">
  {
    items.map((item) => (
      <li class="feature">
        {item.glyph && (
          <svg class="feature-glyph" viewBox="0 0 20 20" width="22" height="22" aria-hidden="true" set:html={glyphs[item.glyph]} />
        )}
        <Heading class="feature-title">{item.href ? <a href={item.href} {...externalLinkProps(item.href)}>{item.title}</a> : item.title}</Heading>
        <p class="feature-body">{item.body}</p>
      </li>
    ))
  }
</ul>

<style>
  .feature-grid {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2vw, 3rem) clamp(1.5rem, 1rem + 2vw, 3rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cols-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .feature {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line-strong);
  }
  .feature-glyph {
    fill: none;
    stroke: var(--accent-text);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-bottom: 0.25rem;
  }
  .feature-title {
    font-size: var(--text-lg);
    font-family: var(--font-sans);
    font-weight: 640;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .feature-title a {
    color: inherit;
    text-decoration-color: var(--line-strong);
  }
  .feature-body {
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
