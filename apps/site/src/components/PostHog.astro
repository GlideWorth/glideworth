---
/**
 * PostHog on every marketing page, the calculators under /tools/ included: official hosted build only
 * (PUBLIC_POSTHOG_PROJECT_TOKEN and PUBLIC_POSTHOG_HOST set). Cookieless, through /relay on this origin, with
 * query strings and calculator text removed before sending (src/lib/posthog.ts, posthog-client.ts,
 * posthog-scrub.ts). A self-hosted build renders nothing, so its pages carry neither the meta tag nor the script.
 */
import { PUBLIC_POSTHOG_HOST, PUBLIC_POSTHOG_PROJECT_TOKEN } from "astro:env/server";
import { sitePostHog } from "../lib/posthog";
import { SITE_POSTHOG_META } from "../lib/posthog-client";

const config = sitePostHog(PUBLIC_POSTHOG_PROJECT_TOKEN, PUBLIC_POSTHOG_HOST);
---

{
  config && (
    <>
      <meta name={SITE_POSTHOG_META} content={config.token} data-ui-host={config.uiHost} />
      <script>
        import { startSitePostHog } from "../lib/posthog-client";
        startSitePostHog();
      </script>
    </>
  )
}
